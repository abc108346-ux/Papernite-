rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(matchId);
      allow delete: if isSignedIn();
      
      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(playerId) && (request.auth.uid == playerId || playerId.matches('^bot_.*'));
        allow delete: if isSignedIn() && (request.auth.uid == playerId || playerId.matches('^bot_.*'));
      }
      
      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(eventId);
      }
    }
  }
}
