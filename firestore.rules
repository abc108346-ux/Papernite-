rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 30 &&
             data.skinId is string && data.skinId.size() <= 50 &&
             data.weaponId is string && data.weaponId.size() <= 50;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId) &&
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && isOwner(userId) &&
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'photoURL', 'skinId', 'weaponId', 'kills', 'deaths', 'wins', 'matchesPlayed', 'status', 'updatedAt']);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) &&
                    (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if isSignedIn() &&
                     (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(requestId) &&
                       request.resource.data.fromUid == request.auth.uid &&
                       request.resource.data.status == 'pending';
      allow update: if isSignedIn() && isValidId(requestId) &&
                       (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isSignedIn() && isValidId(requestId) &&
                       (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
  }
}
