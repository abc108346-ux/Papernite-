{
  "entities": {
    "Match": {
      "title": "Match",
      "description": "A game match",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["waiting", "playing", "finished"] },
        "mapId": { "type": "string" },
        "scoreRed": { "type": "number" },
        "scoreBlue": { "type": "number" },
        "timeRemaining": { "type": "number" },
        "winner": { "type": "string", "enum": ["RED", "BLUE", "DRAW", "NONE"] },
        "createdAt": { "type": "number" },
        "hostId": { "type": "string" }
      },
      "required": ["status", "mapId", "createdAt", "hostId"]
    },
    "PlayerState": {
      "title": "Player State",
      "description": "Player in a match",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "skinId": { "type": "string" },
        "weaponId": { "type": "string" },
        "team": { "type": "string", "enum": ["RED", "BLUE"] },
        "pos": { "type": "object" },
        "rotY": { "type": "number" },
        "pitch": { "type": "number" },
        "isShooting": { "type": "boolean" },
        "isAiming": { "type": "boolean" },
        "isReloading": { "type": "boolean" },
        "isDead": { "type": "boolean" },
        "health": { "type": "number" },
        "maxHealth": { "type": "number" },
        "kills": { "type": "number" },
        "deaths": { "type": "number" },
        "ping": { "type": "number" },
        "respawnTimer": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "team", "pos", "health", "updatedAt"]
    },
    "GameEvent": {
      "title": "Game Event",
      "description": "Transient game events like shooting or hits",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["shoot", "hit", "kill", "respawn"] },
        "timestamp": { "type": "number" },
        "data": { "type": "string" }
      },
      "required": ["type", "timestamp", "data"]
    }
  },
  "firestore": {
    "matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Active and past matches"
    },
    "matches/{matchId}/players/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerState" },
      "description": "Players in a match"
    },
    "matches/{matchId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/GameEvent" },
      "description": "Game events for the match"
    }
  }
}
